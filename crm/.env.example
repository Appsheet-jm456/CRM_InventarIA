# Copia de supabase/.env (llaves de la instancia del CRM). El .env.local NUNCA se versiona.
NEXT_PUBLIC_SUPABASE_URL=http://localhost:8020
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Solo servidor: crea usuarios y cambia contraseñas. Nunca con prefijo NEXT_PUBLIC.
SUPABASE_SERVICE_ROLE_KEY=
# Solo servidor: envío de los asesores por la Cloud API de Meta (copia de ../.env.meta).
META_TOKEN=
META_PHONE_NUMBER_ID=
META_WABA_ID=

# Chat InventarIA → receptor (decisión 0025); el mismo token que CRM_INTERNO_TOKEN de .env.meta
CRM_INTERNO_URL=http://127.0.0.1:8095
CRM_INTERNO_TOKEN=
